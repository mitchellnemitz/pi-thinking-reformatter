  "scripts": {
    "typecheck": "tsc -p pi/tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "~0.87.0",
    "@types/node": "22.19.21",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": ["./pi"]
  }
}
