{
  "name": "pi-thinking-reformatter",
  "version": "1.0.0",
  "author": "Mitchell Nemitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchellnemitz/pi-thinking-reformatter.git"
  },
  "homepage": "https://github.com/mitchellnemitz/pi-thinking-reformatter#readme",
  "bugs": {
    "url": "https://github.com/mitchellnemitz/pi-thinking-reformatter/issues"
